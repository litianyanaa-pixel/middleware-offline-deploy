# 原始物料仓库与打包产物: 体积大(数 GB), 走内部流程单独保管/传输
warehouse/
dist/

# Python 运行产物
__pycache__/
*.py[cod]

# 本地运行日志与临时文件
*.log
tmp_*/
tmp_*
*.tmp

# 本地下载的镜像工具(crane 等)
tools/bin/

# 本地手工备份(重构/发布前快照; git 历史即远端备份)
backups/

# 打包器生成的样例配置(个人本地文件)
example-config.json
/kkstage/
# 根目录的历史 kubekey 试验目录(源码已收编入库: third_party/kubekey, 按 Apache-2.0 分发)
/kubekey/
.workbuddy/
